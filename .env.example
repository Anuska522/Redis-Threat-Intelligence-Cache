# Application Configuration
APP_NAME=Real-Time Threat Intelligence Cache and Malicious URL/IP Detection System Using Redis
APP_ENV=development
DEBUG=false
HOST=127.0.0.1
PORT=8000

# Redis Configuration
# If a standalone Redis server is running on REDIS_URL, the system automatically connects to it.
# If unavailable or during isolated offline testing, it falls back seamlessly to the integrated in-memory Redis engine.
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_TIMEOUT_SECONDS=2.0
REDIS_MAX_CONNECTIONS=20

# Threat Intelligence Provider: "demo" or "virustotal"
CTI_PROVIDER=demo

# VirusTotal API Credentials (Required only when CTI_PROVIDER=virustotal)
VIRUSTOTAL_API_KEY=
VIRUSTOTAL_TIMEOUT_SECONDS=5.0

# Cache TTL Policies (in seconds)
TTL_MALICIOUS_SECONDS=7200
TTL_BENIGN_SECONDS=3600
TTL_UNKNOWN_SECONDS=300

# Security & Administrative Credentials
ADMIN_API_KEY=adminkey-threat-intel-2026-secure
ALERT_RISK_THRESHOLD=75

# CORS Configuration (JSON array of allowed origins)
CORS_ORIGINS=["http://localhost:8000","http://127.0.0.1:8000"]
